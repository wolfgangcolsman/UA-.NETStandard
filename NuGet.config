<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear/>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- ZONTAL fork: the RaftCs packages patched in zontal.ghe.com/studio/raft-cs (see NOTICE.md).
         The feed needs credentials that can read the studio packages. Add them for the source
         "studio" in a user-level NuGet.config with "dotnet nuget update source studio", giving a
         user name and a token; CI adds them before restoring. -->
    <add key="studio" value="https://nuget.zontal.ghe.com/studio/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="studio">
      <package pattern="RaftCs" />
      <package pattern="RaftCs.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <!-- Clearing packageSources above does not re-enable a source that a user or
       machine level NuGet.config has disabled, so a checkout could end up with no
       usable feed at all and fail to restore any package that is not already in
       the global packages folder. Clear the disabled list as well so the feed
       declared here is always the one that is used. -->
  <disabledPackageSources>
    <clear/>
  </disabledPackageSources>
</configuration>